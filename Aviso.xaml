<Window x:Class="SaludNotebook.Aviso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salud del Notebook" Width="390" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded">
    <Border Background="White" CornerRadius="10" BorderBrush="#CFD8DC" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <Border x:Name="Franja" Background="#C62828" CornerRadius="10,10,0,0" Padding="16,10">
                <TextBlock Text="Salud del Notebook" Foreground="White" FontWeight="Bold" FontSize="15"/>
            </Border>
            <StackPanel Margin="16,12,16,14">
                <TextBlock x:Name="Titulo" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Foreground="#263238"/>
                <TextBlock x:Name="Detalle" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ver detalles" Padding="14,6" Margin="0,0,8,0" Click="Abrir_Click"
                            Background="#1565C0" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                    <Button Content="Cerrar" Padding="14,6" Click="Cerrar_Click"
                            Background="#ECEFF1" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
