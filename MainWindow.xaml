<Window x:Class="SaludNotebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salud del Notebook" Height="800" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8"
        FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- Tarjeta para cada hallazgo -->
        <DataTemplate x:Key="PlantillaHallazgo">
            <Border Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="16,12"
                    BorderBrush="{Binding Color}" BorderThickness="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30" VerticalAlignment="Top" Margin="0,2,14,0">
                        <Ellipse Fill="{Binding Color}"/>
                        <TextBlock Text="{Binding Icono}" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="15" Foreground="#263238" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Valor}" FontWeight="Bold" FontSize="17" Foreground="{Binding Color}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Explicacion}" Foreground="#546E7A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrincipal}">
            <Setter Property="Background" Value="#546E7A"/>
        </Style>

        <!-- Interruptor tipo celular para los programas de inicio y ajustes -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Pista" CornerRadius="12" Background="#B0BEC5"/>
                                <Ellipse x:Name="Boton" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista" Property="Background" Value="#2E7D32"/>
                                <Setter TargetName="Boton" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú lateral -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Fondo" Padding="16,9" Margin="0,1,10,1" CornerRadius="6" Background="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#E3EAF2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Padding" Value="16,16,16,4"/>
                                <Setter Property="Foreground" Value="#90A4AE"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Ayuda" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Background="#263238" Padding="22,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BotonPdf" Content="📄  Exportar informe PDF" Style="{StaticResource BotonSecundario}"
                            Margin="0,0,10,0" Click="Pdf_Click"/>
                    <Button x:Name="BotonRevisar" Content="⟳  Volver a revisar" Style="{StaticResource BotonPrincipal}"
                            Margin="0" Click="Revisar_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Salud del Notebook" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="TextoEquipo" Foreground="#B0BEC5" Text="Leyendo información del equipo..."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Veredicto general -->
        <Border Grid.Row="1" x:Name="Banner" Background="#607D8B" Padding="22,14">
            <StackPanel>
                <TextBlock x:Name="TextoBanner" Foreground="White" FontSize="20" FontWeight="Bold" Text="Revisando tu notebook..."/>
                <TextBlock x:Name="SubtextoBanner" Foreground="White" Opacity="0.9" TextWrapping="Wrap"
                           Text="Esto toma unos segundos."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Pestanas" Margin="10,12,12,12" Background="#F3F5F8" BorderThickness="0"
                    TabStripPlacement="Left" SelectionChanged="Pestanas_SelectionChanged">

            <!-- ================= RESUMEN ================= -->
            <TabItem Header="Resumen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="¿Cómo está cada parte?"/>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,-6,0,12" Text="Haz clic en una tarjeta para ver el detalle."/>
                        <ItemsControl x:Name="TarjetasResumen">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="270" MinHeight="120" Margin="0,0,14,14" Background="White" CornerRadius="10"
                                            Padding="16" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Tarjeta_Click"
                                            BorderBrush="{Binding Color}" BorderThickness="0,6,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="24" Margin="0,0,10,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="SemiBold" Foreground="#263238"/>
                                                    <TextBlock Text="{Binding EstadoTexto}" FontWeight="Bold" Foreground="{Binding Color}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Resumen}" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Tu equipo" Margin="0,10,0,12"/>
                        <Border Style="{StaticResource Tarjeta}" Padding="18">
                            <StackPanel>
                                <Grid x:Name="DatosEquipo">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BotonVantage" Content="Abrir Lenovo Vantage" Style="{StaticResource BotonPrincipal}"
                                            Click="Vantage_Click" Visibility="Collapsed"
                                            ToolTip="La app de Lenovo para actualizar drivers y BIOS de tu modelo"/>
                                    <Button Content="Página de soporte del fabricante" Style="{StaticResource BotonSecundario}" Click="Soporte_Click"/>
                                    <Button Content="Copiar número de serie" Style="{StaticResource BotonSecundario}" Click="CopiarSerie_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= COMPONENTES ================= -->
            <TabItem Header="Componentes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <ItemsControl x:Name="ListaComponentes" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <TextBlock Style="{StaticResource TituloSeccion}" Margin="0,8,0,12" Text="Lo que hay dentro de tu notebook"/>
                        <ItemsControl x:Name="TarjetasComponentes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="24" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Categoria}" Foreground="#78909C" FontSize="12"/>
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="15" Foreground="#263238" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detalle}" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{Binding Color}" CornerRadius="12" Padding="10,3"
                                                    VerticalAlignment="Top" Margin="12,0,0,0" MaxWidth="260">
                                                <TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,8,0,0"
                                   Text="Nota: Windows puede saber si una pieza funciona, pero no su desgaste físico (polvo, ventiladores, pasta térmica). Para eso usa &quot;Modo juego&quot;."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Batería">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaBateria" Margin="12,0,12,12" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Disco">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <ItemsControl x:Name="ListaDisco" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <Button Content="🧹  Liberar espacio" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                Click="IrALimpieza_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Temperatura">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <ItemsControl x:Name="ListaTemperatura" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <Button Content="🎮  Medir mientras juego" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                Click="IrAModoJuego_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Rendimiento">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <ItemsControl x:Name="ListaRendimiento" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <Button Content="Ver programas abiertos y de inicio" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left"
                                Click="IrAProgramas_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= DRIVERS ================= -->
            <TabItem Header="Drivers">
                <Grid Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="330"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaDrivers" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Style="{StaticResource TituloSeccion}" Margin="0,8,0,8" Text="Todos los drivers instalados"/>
                    <DataGrid Grid.Row="2" x:Name="TablaDrivers" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                              RowBackground="White" AlternatingRowBackground="#F7F9FB" BorderThickness="0"
                              HorizontalGridLinesBrush="#ECEFF1" CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Antiguo}" Value="True">
                                        <Setter Property="Background" Value="#FFF4D6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Dispositivo}" Width="2*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                            <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" SortMemberPath="Fecha"/>
                            <DataGridTextColumn Header="" Binding="{Binding Comentario}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= ACTUALIZACIONES ================= -->
            <TabItem Header="Actualizaciones">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <WrapPanel>
                            <Button Content="Abrir Windows Update" Style="{StaticResource BotonPrincipal}" Click="WindowsUpdate_Click"/>
                            <Button Content="Ver actualizaciones opcionales" Style="{StaticResource BotonSecundario}" Click="Opcionales_Click"/>
                            <Button x:Name="BotonVantage2" Content="Abrir Lenovo Vantage" Style="{StaticResource BotonSecundario}"
                                    Click="Vantage_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <TextBlock x:Name="EstadoActualizaciones" Style="{StaticResource Ayuda}" Margin="0,0,0,10"
                                   Text="Buscando actualizaciones en Windows Update (puede tardar un par de minutos)..."/>
                        <ItemsControl x:Name="ListaActualizaciones" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <ItemsControl x:Name="ListaPendientes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Instalar" Style="{StaticResource BotonPrincipal}"
                                                    Margin="12,0,0,0" Padding="14,5" VerticalAlignment="Center"
                                                    Tag="{Binding}" IsEnabled="{Binding PuedeInstalar}" Click="Instalar_Click"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding EstadoInstalacion}" FontWeight="SemiBold"
                                                       Foreground="#1565C0" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tipo}" Foreground="#78909C"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= FALLOS ================= -->
            <TabItem Header="Fallos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Aquí aparecen las veces que Windows se cayó (pantallazo azul) o el notebook se apagó de golpe en los últimos 90 días, con la causa explicada."/>
                        <WrapPanel>
                            <Button Content="Diagnóstico de memoria RAM" Style="{StaticResource BotonSecundario}" Click="DiagnosticoMemoria_Click"
                                    ToolTip="Reinicia el notebook y revisa la RAM (tarda unos 15 minutos)"/>
                        </WrapPanel>
                        <ItemsControl x:Name="ListaFallosResumen" ItemTemplate="{StaticResource PlantillaHallazgo}"/>
                        <TextBlock Style="{StaticResource TituloSeccion}" Margin="0,8,0,12" Text="Detalle"/>
                        <TextBlock x:Name="SinFallos" Style="{StaticResource Ayuda}" Visibility="Collapsed"
                                   Text="No hubo fallos en los últimos 90 días. 🎉"/>
                        <ItemsControl x:Name="ListaFallos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="16,12"
                                            BorderBrush="{Binding Color}" BorderThickness="6,0,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FechaTexto}" Foreground="#78909C"/>
                                                <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" FontSize="15" Foreground="#263238"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Causa}" FontWeight="Bold" FontSize="16" Foreground="{Binding Color}"
                                                       Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Codigo}" Foreground="#90A4AE" FontSize="12"/>
                                            <TextBlock Text="{Binding Explicacion}" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="HERRAMIENTAS" IsEnabled="False"/>

            <!-- ================= MODO JUEGO ================= -->
            <TabItem Header="🎮 Modo juego">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Medir temperaturas mientras juegas"/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Aprieta &quot;Empezar&quot;, minimiza esta ventana y juega como siempre. Cuando termines, vuelve y aprieta &quot;Terminar&quot;: te diré la temperatura máxima y si tu notebook necesita limpieza."/>
                        <Button x:Name="BotonJuego" Content="▶  Empezar a medir" Style="{StaticResource BotonPrincipal}"
                                HorizontalAlignment="Left" Padding="22,10" FontSize="15" Click="Juego_Click"/>

                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,12">
                                <StackPanel>
                                    <TextBlock Text="Tarjeta gráfica" Foreground="#78909C"/>
                                    <TextBlock x:Name="JuegoGpu" Text="-" FontSize="30" FontWeight="Bold" Foreground="#E65100"/>
                                    <TextBlock x:Name="JuegoGpuMax" Text="Máxima: -" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,12">
                                <StackPanel>
                                    <TextBlock Text="Sistema / procesador" Foreground="#78909C"/>
                                    <TextBlock x:Name="JuegoSistema" Text="-" FontSize="30" FontWeight="Bold" Foreground="#1565C0"/>
                                    <TextBlock x:Name="JuegoSistemaMax" Text="Máxima: -" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}">
                                <StackPanel>
                                    <TextBlock Text="Tiempo midiendo" Foreground="#78909C"/>
                                    <TextBlock x:Name="JuegoTiempo" Text="0:00" FontSize="30" FontWeight="Bold" Foreground="#263238"/>
                                    <TextBlock x:Name="JuegoUso" Text="Uso de la gráfica: -" Foreground="#546E7A"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Rectangle Width="14" Height="4" Fill="#E65100" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tarjeta gráfica" Foreground="#546E7A" Margin="0,0,16,0"/>
                                    <Rectangle Width="14" Height="4" Fill="#1565C0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sistema" Foreground="#546E7A"/>
                                </StackPanel>
                                <Canvas x:Name="GraficoJuego" Height="220" ClipToBounds="True" SizeChanged="GraficoJuego_SizeChanged"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CajaVeredicto" Style="{StaticResource Tarjeta}" BorderThickness="6,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="VeredictoJuego" TextWrapping="Wrap" FontSize="15"/>
                        </Border>

                        <TextBlock Style="{StaticResource TituloSeccion}" Margin="0,8,0,12" Text="Sesiones anteriores"/>
                        <ItemsControl x:Name="ListaSesiones">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Margin="0,0,0,8" Padding="14,10"
                                            BorderBrush="{Binding Color}" BorderThickness="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding FechaTexto, Mode=OneWay}"/>
                                                <Run Text="  ·  " Foreground="#B0BEC5"/>
                                                <Run Text="{Binding DuracionTexto, Mode=OneWay}"/>
                                                <Run Text="  ·  Gráfica máx. " Foreground="#78909C"/>
                                                <Run Text="{Binding GpuTexto, Mode=OneWay}"/>
                                                <Run Text="  ·  Sistema máx. " Foreground="#78909C"/>
                                                <Run Text="{Binding SistemaTexto, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Veredicto}" Foreground="#546E7A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= LIMPIEZA ================= -->
            <TabItem Header="🧹 Liberar espacio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Liberar espacio en el disco"/>
                        <TextBlock x:Name="EspacioActual" Style="{StaticResource Ayuda}" FontSize="15" Text="Calculando..."/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Marca lo que quieres borrar. Todo esto son archivos que Windows y los programas vuelven a crear si los necesitan; tus documentos, fotos y juegos no se tocan."/>
                        <ItemsControl x:Name="ListaLimpieza">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TamanoTexto}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#263238"/>
                                                <TextBlock Text="{Binding Resultado}" Foreground="#2E7D32" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding Seleccionado}" VerticalAlignment="Top" Margin="0,3,12,0" Checked="Limpieza_Cambio" Unchecked="Limpieza_Cambio"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding Descripcion}" Foreground="#546E7A" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="BotonLimpiar" Content="🧹  Liberar espacio" Style="{StaticResource BotonPrincipal}"
                                    Padding="22,10" FontSize="15" Click="Limpiar_Click"/>
                            <Button Content="Calcular de nuevo" Style="{StaticResource BotonSecundario}" Padding="16,10" Click="AnalizarLimpieza_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TotalLimpieza" Style="{StaticResource Ayuda}" FontWeight="SemiBold"/>

                        <Border Style="{StaticResource Tarjeta}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Tu carpeta Descargas" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="TextoDescargas" Style="{StaticResource Ayuda}" Margin="0,2,0,8"
                                           Text="Calculando..."/>
                                <WrapPanel>
                                    <Button Content="Abrir Descargas" Style="{StaticResource BotonSecundario}" Click="AbrirDescargas_Click"/>
                                    <Button Content="Programas instalados (desinstalar)" Style="{StaticResource BotonSecundario}" Click="AbrirAplicaciones_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= PROGRAMAS ================= -->
            <TabItem Header="📋 Programas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Programas abiertos"/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Vienen marcados los que no están usando el procesador. Las ventanas se cierran normalmente: si tienen algo sin guardar, te van a preguntar."/>
                        <WrapPanel>
                            <Button x:Name="BotonCerrarProgramas" Content="Cerrar seleccionados" Style="{StaticResource BotonPrincipal}" Click="CerrarProgramas_Click"/>
                            <Button Content="Actualizar lista" Style="{StaticResource BotonSecundario}" Click="ActualizarProgramas_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="EstadoProgramas" Style="{StaticResource Ayuda}" Text="Cargando..."/>
                        <ItemsControl x:Name="ListaAbiertos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Seleccionado}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Resultado}" Foreground="#2E7D32" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Right" Width="70" TextAlignment="Right" Text="{Binding CpuTexto}" Foreground="#546E7A" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Width="80" TextAlignment="Right" Text="{Binding RamTexto}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Width="130" Text="{Binding TipoTexto}" Foreground="#78909C" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource TituloSeccion}" Margin="0,20,0,12" Text="Programas que arrancan con Windows"/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Mientras menos programas arranquen solos, más rápido enciende el notebook. Apagar uno aquí no lo desinstala: lo puedes seguir abriendo cuando quieras."/>
                        <ItemsControl x:Name="ListaInicio">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Interruptor}" IsChecked="{Binding Activo}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Nombre, Mode=OneWay}"/>
                                                    <Run Text="{Binding Origen, Mode=OneWay}" Foreground="#90A4AE" FontWeight="Normal" FontSize="12"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Comando}" Foreground="#78909C" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Error}" Foreground="#C62828" FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= HISTORIAL ================= -->
            <TabItem Header="📈 Historial">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Cómo ha cambiado tu notebook"/>
                        <TextBlock Style="{StaticResource Ayuda}"
                                   Text="Se guarda un registro cada día que abres la app (y en cada revisión semanal automática)."/>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Tarjeta}" Margin="0,0,10,12">
                                <StackPanel>
                                    <TextBlock Text="Vida útil de la batería" FontWeight="SemiBold"/>
                                    <Canvas x:Name="GraficoBateria" Height="160" ClipToBounds="True" Margin="0,8,0,0" SizeChanged="Historial_SizeChanged"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}">
                                <StackPanel>
                                    <TextBlock Text="Espacio libre en el disco" FontWeight="SemiBold"/>
                                    <Canvas x:Name="GraficoDisco" Height="160" ClipToBounds="True" Margin="0,8,0,0" SizeChanged="Historial_SizeChanged"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <DataGrid x:Name="TablaHistorial" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                                  RowBackground="White" AlternatingRowBackground="#F7F9FB" BorderThickness="0"
                                  HorizontalGridLinesBrush="#ECEFF1" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" SortMemberPath="Fecha" Width="Auto"/>
                                <DataGridTextColumn Header="Batería" Binding="{Binding SaludBateria, StringFormat={}{0:0}%}" Width="*"/>
                                <DataGridTextColumn Header="Ciclos" Binding="{Binding CiclosBateria}" Width="*"/>
                                <DataGridTextColumn Header="Disco libre" Binding="{Binding DiscoLibreGb, StringFormat={}{0:0} GB}" Width="*"/>
                                <DataGridTextColumn Header="Desgaste SSD" Binding="{Binding DesgasteSsd, StringFormat={}{0:0}%}" Width="*"/>
                                <DataGridTextColumn Header="Temp. sistema" Binding="{Binding TempSistema, StringFormat={}{0:0} °C}" Width="*"/>
                                <DataGridTextColumn Header="Temp. gráfica" Binding="{Binding TempGpu, StringFormat={}{0:0} °C}" Width="*"/>
                                <DataGridTemplateColumn Header="Estado" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= AJUSTES ================= -->
            <TabItem Header="⚙ Ajustes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource TituloSeccion}" Text="Ajustes"/>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <CheckBox x:Name="ChkSemanal" Style="{StaticResource Interruptor}" Click="Semanal_Click">
                                    <TextBlock Text="Revisión automática cada semana" FontWeight="SemiBold" FontSize="15"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Ayuda}" Margin="54,4,0,0"
                                           Text="Todos los lunes a las 13:00 (o apenas prendas el notebook, si estaba apagado) la app revisa todo en silencio. Si algo está en rojo, te aparece un aviso en la esquina de la pantalla."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Abrir sin que Windows pida permiso" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Ayuda}" Margin="0,4,0,10"
                                           Text="Crea un acceso directo &quot;Salud del Notebook&quot; en el escritorio y en el menú Inicio que abre la app directamente, sin la ventana de &quot;¿Quieres permitir...?&quot;."/>
                                <WrapPanel>
                                    <Button x:Name="BotonAcceso" Content="Crear acceso directo" Style="{StaticResource BotonPrincipal}" Click="AccesoDirecto_Click"/>
                                    <TextBlock x:Name="EstadoAcceso" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <TextBlock Text="Informe en PDF" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Ayuda}" Margin="0,4,0,10"
                                           Text="Un documento con todo lo que revisa la app (estado, componentes, fallos, temperaturas jugando). Sirve para guardarlo o llevarlo al técnico. Se guarda en tu carpeta Documentos."/>
                                <Button Content="📄  Exportar informe PDF" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left" Click="Pdf_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="EstadoAjustes" Foreground="#C62828" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
